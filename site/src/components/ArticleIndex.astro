---
import { articles } from '../lib/registry';
import { withBase } from '../lib/base';
import Arrow from './Arrow.astro';
---
<ol class="article-index">{articles.map((entry, i) => <li><a class="index-link" href={withBase(`/articles/${entry.slug}/`)}><span class="index-num mono">{String(i + 1).padStart(2, '0')}</span><div><h3>{entry.title}</h3><p>{entry.description}</p><div class="index-meta"><span>{entry.section}</span><span>·</span><span>{entry.minutes} min read</span></div></div><Arrow /></a></li>)}</ol>
